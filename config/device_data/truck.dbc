CM_ "Illustrative heavy-truck CAN FD network for the iHarmony truck lab. Not a production or OEM database.";
CM_ BO_ 2566852647 "Driver inputs and load case, sent by the test bench to the vehicle control unit.";
CM_ BO_ 2365530151 "Vehicle state, broadcast every 100 ms on CAN FD with an alive counter and a CRC-8 over bytes 0-14.";
CM_ BO_ 2365526027 "Deceleration demand and road context, sent by the test bench to the brake ECU.";
CM_ BO_ 2365530123 "Axle brake pressures and brake state, broadcast every 50 ms on CAN FD with an alive counter and CRC-8.";
CM_ BO_ 2566856707 "Gear state, broadcast every 100 ms.";
CM_ BO_ 2566848761 "Identification request: target = source address of the ECU (0x27 VCU, 0x0B EBS, 0x03 TCU).";
CM_ SG_ 2365530151 drive_state "0 off, 1 standstill, 2 accelerating, 3 cruising, 4 braking, 5 speed limited";
CM_ SG_ 2365530151 comm_fault "1 while DriverDemand is missing (timeout): accelerator demand ignored";
CM_ SG_ 2365530123 brake_state "0 released, 1 applying, 2 holding, 3 ABS regulating";
BA_DEF_ BO_ "VFrameFormat" ENUM "StandardCAN","ExtendedCAN","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","reserved","StandardCAN_FD","ExtendedCAN_FD";
BA_DEF_ "BusType" STRING ;
BA_DEF_DEF_ "VFrameFormat" "ExtendedCAN";
BA_DEF_DEF_ "BusType" "CAN FD";
BA_ "BusType" "CAN FD";
BA_ "VFrameFormat" BO_ 2365530151 15;
BA_ "VFrameFormat" BO_ 2365530123 15;
